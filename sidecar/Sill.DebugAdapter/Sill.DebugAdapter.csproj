<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vendored from Passenger (https://github.com/Zaneris/passenger at 7686138, MIT), ported to .NET 10; see
       THIRD_PARTY_NOTICES.md. -->
  <!-- The debug adapter: the debugger's engine behind the Debug Adapter Protocol, in a process of its own (a
       debugger's native side failing takes this process down, not the IDE). The app carries it under debugger/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sill.DebugAdapter</RootNamespace>
    <!-- Run by the person's dotnet (`dotnet Sill.DebugAdapter.dll`), the newest runtime there, as the sidecar is: no
         apphost, so the app carries no native code of it. -->
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sill.Dap/Sill.Dap.csproj" />
    <ProjectReference Include="../Sill.Debugger/Sill.Debugger.csproj" />
  </ItemGroup>
</Project>
