<Project Sdk="Microsoft.NET.Sdk">
  <!-- The profiler, vendored from Passenger: a program started held at a diagnostic port of its own, EventPipe's
       samples streamed to a .nettrace file and read with TraceEvent; heap snapshots through createdump, read with
       ClrMD, and compared object by object. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
  </ItemGroup>
</Project>
