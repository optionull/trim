<Project Sdk="Microsoft.NET.Sdk">
  <!-- sill's .NET sidecar. Runs on the user's own dotnet (`dotnet Sill.Sidecar.dll`), published framework-dependent
       with no apphost, so the app bundle carries no native code of it to sign and needs no JIT entitlements. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- TraceEvent copies its Windows-only native helpers (KernelTraceControl, Microsoft's msdia140) into every output;
       they do nothing on macOS, and msdia140 is not open source: they never ship. -->
  <Target Name="DropWindowsNatives" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)x86;$(PublishDir)amd64;$(PublishDir)arm64" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Sill.Profiler/Sill.Profiler.csproj" />
  </ItemGroup>
</Project>
