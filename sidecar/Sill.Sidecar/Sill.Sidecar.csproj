<Project Sdk="Microsoft.NET.Sdk">
  <!-- sill's .NET sidecar. Runs on the user's own dotnet (`dotnet Sill.Sidecar.dll`), published framework-dependent
       with no apphost, so the app bundle carries no native code of it to sign and needs no JIT entitlements. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
