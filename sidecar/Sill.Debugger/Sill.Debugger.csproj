<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vendored from Passenger (https://github.com/Zaneris/passenger at 7686138, MIT), ported to .NET 10; see
       THIRD_PARTY_NOTICES.md. -->
  <!-- The debugger's engine, run in the adapter's process: ICorDebug for processes, breakpoints, stepping, stacks
       and values, Roslyn's expression compiler for evaluation, ILSpy's decompiler for code without source. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The expression compiler and the decompiler are driven through members their assemblies keep internal. -->
  <ItemGroup>
    <Publicize Include="Microsoft.CodeAnalysis" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.CSharp" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.ExpressionEvaluator.ExpressionCompiler" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="ICSharpCode.Decompiler" IncludeCompilerGeneratedMembers="false" MemberPattern="^ICSharpCode\.Decompiler\.(CSharp\.Transforms\.RemoveEmbeddedAttributes|DebugInfo)\..*" />
  </ItemGroup>

  <Import Project="../Publicize.targets" />

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="MP.Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" Version="5.9.0" />
    <!-- dbgshim, the native library that starts and attaches to a .NET process, is not a package here: sill downloads
         it on the person's machine (it is native code, which the app carries none of) and the adapter loads it from there. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
    <ProjectReference Include="../Sill.Debugger.Interop/Sill.Debugger.Interop.csproj" />
    <!-- For the protocol's hit counts, read as the IDE's Breakpoint popup reads them (HitCondition). -->
    <ProjectReference Include="../Sill.Dap/Sill.Dap.csproj" />
  </ItemGroup>
</Project>
